# Normalize line endings to LF in the repository and the working tree.
* text=auto eol=lf

# Binary files.
*.png binary
*.jpg binary
*.gif binary

# Development files, excluded from `git archive` (the release zip).
# Add here any other file or folder that is not part of the plugin or theme.
# In a theme, screenshot.png is part of the theme: don't exclude it.
/.gitattributes  export-ignore
/.gitignore      export-ignore
/.claude         export-ignore
/.github         export-ignore
/CLAUDE.md       export-ignore
/README.md       export-ignore
/blueprint.json  export-ignore
/composer.json   export-ignore
/composer.lock   export-ignore
/phpcs.xml.dist  export-ignore

# Plugins only: the WordPress.org images and their sources (see release.md).
# In a theme, assets/ is a regular theme folder: remove these two lines.
/assets          export-ignore
/assets-src      export-ignore
